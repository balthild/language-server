{
	"name": "balthild/language-server",
	"description": "Generic Language Server Platform",
	"license": "MIT",
	"authors": [
		{
			"name": "Balthild",
			"email": "ibalthild@gmail.com"
		},
		{
			"name": "Daniel Leech",
			"email": "daniel@dantleech.com"
		}
	],
	"require": {
		"php": "^8.2",
		"amphp/amp": "^3.0",
		"amphp/byte-stream": "^2.1",
		"amphp/socket": "^2.4",
		"balthild/language-server-protocol": "dev-main#8863c31",
		"dantleech/argument-resolver": "^1.1",
		"dantleech/invoke": "^2.0",
		"psr/event-dispatcher": "^1.0",
		"psr/log": "^1.0",
		"ramsey/uuid": "^4.0",
		"revolt/event-loop": "^1.0"
	},
	"require-dev": {
		"amphp/phpunit-util": "^3.0",
		"ergebnis/composer-normalize": "^2.0",
		"jangregor/phpstan-prophecy": "^1.0",
		"phpactor/phly-event-dispatcher": "~2.0.0",
		"phpactor/test-utils": "~1.1.3",
		"phpspec/prophecy-phpunit": "^2.0",
		"phpstan/phpstan": "^1.0",
		"phpunit/phpunit": "^9.0",
		"phpstan/extension-installer": "^1.1",
		"symfony/var-dumper": "^5.1",
		"carthage-software/mago": "^1.59"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		}
	},
	"autoload": {
		"psr-4": {
			"Phpactor\\LanguageServer\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Phpactor\\LanguageServer\\Tests\\": "tests/",
			"Phpactor\\LanguageServer\\Internal\\": "internal/",
			"AcmeLs\\": "example/server/acme-ls/"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"integrate": [
			"./vendor/bin/phpunit",
			"./vendor/bin/phpstan --memory-limit=-1 analyze",
			"dprint fmt",
			"php ./internal/bin/scan-single-param.php"
		]
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"phpstan/extension-installer": true
		}
	}
}
